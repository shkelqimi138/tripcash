# TripCash server-side configuration.
#
# These values are used only by the Cloudflare Pages Functions in functions/.
# In production they are set as Cloudflare Pages environment variables/secrets.
# For local function development with `npx wrangler pages dev dist`, copy this
# file to `.dev.vars`. `npm start` and the tests do not need any of them.
# The public Supabase URL and anon key for the browser are in web/scripts/supabase.js.

# Supabase public anon key, used by functions to verify the caller's session
SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase secret key (service role); used only by account closure to delete a user. Keep private.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare Turnstile secret for the landing-page contact form
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Resend API key for contact, welcome, and account-closure emails
RESEND_API_KEY=your_resend_api_key
# Optional sender address; each function has a tripcash.de default
CONTACT_FROM_EMAIL="TripCash <hello@example.com>"

# OpenAI API key for receipt scanning (/api/receipt-scan)
OPENAI_API_KEY=your_openai_api_key
# Optional model override; defaults to gpt-5.4-mini
OPENAI_RECEIPT_MODEL=gpt-5.4-mini

# Sign in with Apple token revocation on account closure (see docs/apple-revocation-setup.md)
APPLE_TEAM_ID=your_apple_team_id
APPLE_CLIENT_ID=com.example.app
APPLE_KEY_ID=your_apple_key_id
# Contents of the .p8 key, including the BEGIN/END PRIVATE KEY lines
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Local Supabase integration tests only (npm run test:integration); optional, defaults to
# Cloudflare's documented always-pass test secret
SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA

# Not a variable: contact.js also uses an optional Cloudflare rate-limit binding named
# CONTACT_RATE_LIMITER, configured in the Pages project settings.
